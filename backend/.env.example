# Local: postgres://postgres:postgres@localhost:5432/verbatim?sslmode=disable
# RDS (production): postgres://<user>:<password>@<rds-endpoint>:5432/verbatim?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/verbatim?sslmode=disable
SUPADATA_API_KEY=
OPENAI_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=
FRONTEND_ORIGIN=http://localhost:5173
JWT_SECRET=
# COOKIE_SECURE=true in production only (needs real HTTPS on both ends for
# SameSite=None+Secure auth cookies to work) — leave unset/false locally.
COOKIE_SECURE=
